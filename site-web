            }
            .footer-grid {
                grid-template-columns: 1fr;
            }
            .contact-form {
                padding: 30px;
            }
            .b2b-card {
                padding: 30px;
            }
        }

        /* Mobile Menu Overlay */
        .mobile-menu {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: var(--bg-deep);
